{
  "name": "omicslab-simulator",
  "version": "1.0.0",
  "description": "Africa's interactive omics training platform",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "validate": "node scripts/validate-html.js",
    "lint": "node scripts/validate-html.js && node -e \"require('fs').readdirSync('api').forEach(f=>require('child_process').execSync('node --check api/'+f,{stdio:'inherit'}))\" && eslint . --ext .js,.ts --ignore-path .gitignore",
    "check:console": "grep -rn 'console\\.log(' js/ --include='*.js,.ts' | grep -v 'config.js\\|analytics.js\\|db.js' && exit 1 || exit 0",
    "build:hub": "npm --prefix hub install && npm --prefix hub run build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.2",
    "@pinecone-database/pinecone": "^2.2.2",
    "@upstash/redis": "^1.31.3",
    "@vercel/analytics": "^2.0.1",
    "resend": "^3.2.0",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "html-validate": "^9.4.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}